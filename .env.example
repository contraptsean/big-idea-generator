# News API (https://newsapi.org)
NEWS_API_KEY=your_news_api_key_here

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
DIGEST_RECIPIENT=recipient@example.com

# Neon PostgreSQL (https://neon.tech — free tier)
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Reddit (optional — skipped if not set)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Analysis settings
NEWS_QUERY=technology startup funding
NEWS_PAGE_SIZE=10
